# Test environment overrides. Laravel auto-loads this file when APP_ENV=testing.
# Combined with phpunit.xml's force="true" on APP_ENV, this guarantees test runs
# use the dedicated `testing` DB connection regardless of what .env / env_file
# has set for dev work.

APP_ENV=testing
APP_KEY=base64:NTrXToqFZJlv48dgPc+kNpc3SBt333TfDnF1mDShsBg=

DB_CONNECTION=testing
DB_TEST_HOST=mysql
DB_TEST_PORT=3306
DB_TEST_DATABASE=monica_test
DB_TEST_USERNAME=homestead
DB_TEST_PASSWORD=secret

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=testing
BCRYPT_ROUNDS=4
CHECK_VERSION=false
APP_DEFAULT_LOCALE=en
DAV_ENABLED=true
REQUIRES_SUBSCRIPTION=false
APP_EMAIL_NEW_USERS_NOTIFICATION=
LARAVEL_CLOUDFLARE_ENABLED=false
