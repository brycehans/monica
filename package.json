{
  "private": true,
  "scripts": {
    "dev": "vite",
    "predev": "php artisan lang:generate -vvv",
    "watch": "vite build --watch",
    "prewatch": "php artisan lang:generate -vvv",
    "prod": "yarn production",
    "production": "vite build",
    "preproduction": "php artisan lang:generate -vvv",
    "heroku-postbuild": "yarn run production",
    "e2e": "yarn --cwd tests/playwright run smoke",
    "inst": "yarn install --frozen-lockfile",
    "lint": "eslint *.js 'resources/js/**/*.{js,ts,vue}' 'tests/js/**/*.ts'",
    "lint:fix": "yarn run lint --fix",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "check:ts-version": "node scripts/check-ts-version.mjs",
    "snyk-protect": "snyk-protect",
    "prepublish": "yarn run snyk-protect",
    "migrate": "DB_CONNECTION=testing php artisan migrate:fresh && DB_CONNECTION=testing php artisan db:seed",
    "pretest": "yarn run migrate",
    "test": "vendor/bin/phpunit",
    "posttest": "vendor/bin/phpstan analyse",
    "composer update": "COMPOSER_MEMORY_LIMIT=-1 composer update"
  },
  "engines": {
    "node": "20.x",
    "yarn": "1.22.x"
  },
  "toolFloors": {
    "_comment": "Non-standard mirror of `engines` for dev tooling that isn't a runtime engine. Enforced by scripts/check-ts-version.mjs in CI. Kept out of `engines` because yarn 1 warns on unknown keys there.",
    "typescript": ">=5.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@snyk/protect": "^1.1305.0",
    "@types/lodash": "^4.17.24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0",
    "@vue/test-utils": "^2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-vue": "^10",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "laravel-vite-plugin": "^3.1",
    "postcss": "^8.5.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10",
    "vue-tsc": "^3.3.4"
  },
  "dependencies": {
    "@kyvg/vue3-notification": "^3.4",
    "@simplewebauthn/browser": "^13.3.0",
    "@vueform/multiselect": "^2.6",
    "@vuelidate/core": "^2.0",
    "@vuelidate/validators": "^2.0",
    "@vuepic/vue-datepicker": "^13.0",
    "@vueuse/core": "^14.0",
    "@vueuse/integrations": "^14.0",
    "animate.css": "^4.1",
    "axios": "^1.16",
    "bootstrap": "^4.6",
    "cropperjs": "^1.6.2",
    "date-fns": "^4",
    "dompurify": "^3.4.7",
    "floating-vue": "^5.2",
    "focus-trap": "^8.0",
    "font-awesome": "^4.7",
    "hint.css": "^3.0",
    "list.js": "^2.3",
    "lodash": "^4.18",
    "marked": "^18.0",
    "moment": "^2.30",
    "moment-timezone": "^0.5.48",
    "pretty-checkbox": "^3.0.3",
    "rx-js": "^0.0.0",
    "sass": "^1.99.0",
    "tachyons": "^4.12",
    "vue": "^3.5",
    "vue-cropperjs": "^5.0",
    "vue-final-modal": "^4.5",
    "vue-good-table-next": "^0.2",
    "vue-i18n": "^10.0"
