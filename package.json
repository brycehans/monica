    "brace-expansion": "^1.1.13",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "nanoid": "^3.3.8",
    "postcss": "^8.5.15",
    "qs": "^6.15.2",
    "tmp": "^0.2.7",
    "**/anymatch/picomatch": "^2.3.2",
    "**/micromatch/picomatch": "^2.3.2",
    "**/readdirp/picomatch": "^2.3.2",
    "**/vite-plugin-full-reload/picomatch": "^2.3.2"
  },
  "snyk": true
}
