# ENV FILE FOR THE GITHUB ACTION RUNNING MYSQL
APP_ENV=testing
APP_KEY=base64:NTrXToqFZJlv48dgPc+kNpc3SBt333TfDnF1mDShsBg=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monica
DB_USERNAME=root
DB_PASSWORD=root
DB_USE_UTF8MB4=true

# phpunit.xml forces DB_CONNECTION=testing, which resolves to the 'testing'
# connection in config/database.php — that connection reads from DB_TEST_*
# (separate keys from DB_*). Mirror the values above so phpunit can connect.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=monica
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=root

BROADCAST_DRIVER=log
LOG_CHANNEL=testing

# Values from phpunit.xml
DEBUGBAR_ENABLED=false
CACHE_DRIVER=array
CHECK_VERSION=false
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=array

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
APP_EMAIL_NEW_USERS_NOTIFICATION=
